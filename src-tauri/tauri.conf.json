{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ide",
  "version": "0.1.0",
  "identifier": "com.gordonbeeming.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ide",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

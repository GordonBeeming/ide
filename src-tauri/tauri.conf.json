{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ide",
  "version": "0.1.0",
  "identifier": "com.gordonbeeming.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ide",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "resources": {
      "../dist": "dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Source Code",
        "ext": [
          "rs",
          "ts",
          "tsx",
          "js",
          "jsx",
          "mjs",
          "cjs",
          "cs",
          "c",
          "h",
          "cpp",
          "hpp",
          "cc",
          "java",
          "kt",
          "kts",
          "scala",
          "py",
          "go",
          "rb",
          "php",
          "swift"
        ],
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Web and Style Files",
        "ext": [
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less",
          "vue",
          "svelte"
        ],
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Structured Text and Config",
        "ext": [
          "json",
          "jsonc",
          "md",
          "markdown",
          "txt",
          "toml",
          "yaml",
          "yml",
          "xml",
          "sql",
          "sh",
          "bash",
          "zsh",
          "ps1",
          "bat",
          "cmd",
          "diff",
          "patch",
          "editorconfig",
          "gitignore",
          "dockerignore",
          "env"
        ],
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": ".NET Project Files",
        "ext": [
          "csproj",
          "props",
          "targets",
          "sln"
        ],
        "mimeType": "text/xml",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "targets": "all"
  }
}
